DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# demo: tanpa API Valorant; henrik: data asli dari HenrikDev
DATA_MODE=demo
HENRIK_API_KEY=
DATABASE_PATH=./data/spike.sqlite

# Musik tidak memerlukan API HenrikDev atau API key YouTube.
MUSIC_ENABLED=true
LAVALINK_URL=127.0.0.1:2333
LAVALINK_PASSWORD=manuk-local-only
LAVALINK_SECURE=false
VOTE_SKIP_THRESHOLD=0.5
PLAYLIST_MAX_TRACKS=200
PLAYLIST_PLAY_BATCH=25

# YouTube OAuth: leave empty on first run to start the official device flow.
# After completing it, store the refresh token here (never commit .env).
YOUTUBE_REFRESH_TOKEN=

# Optional local yt-cipher service. Keep disabled until its local endpoint is running.
YT_CIPHER_ENABLED=false
YT_CIPHER_HOST=127.0.0.1
YT_CIPHER_PORT=8001
YT_CIPHER_PASSWORD=
YT_CIPHER_DIR=./yt-cipher

# Optional Spotify application credentials for LavaSrc metadata access.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
